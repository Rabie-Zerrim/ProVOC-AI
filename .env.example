# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-python-secrets-token-hex-32

# These keys are declared but not used in the active codebase — safe to leave as placeholders
OPENAI_API_KEY=not-used-leave-as-is
YELP_API_KEY=not-used-leave-as-is

# Groq API key — get one at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Redis — either set REDIS_URL (takes priority) or the individual vars below
REDIS_URL=redis://:your_redis_password@your_redis_host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=tiny

# Groq model identifier (any Groq-hosted model name works)
LLM_MODEL=llama-3.1-8b-instant

# Comma-separated list of allowed CORS origins — no spaces around commas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# PostgreSQL connection strings
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/provoc_ai_db
DATABASE_URL_SYNC=postgresql://postgres:your_password@localhost:5432/provoc_ai_db

# Set to "true" to run without a real database (MockMilvusClient only)
NO_DB_MODE=false

# Shared secret between pv-ai and the BFF service — generate same way as JWT_SECRET
BFF_SHARED_SECRET=change-me-use-python-secrets-token-hex-32

# MLflow tracking server URL
MLFLOW_TRACKING_URI=http://localhost:5001

# Fine-tuned Whisper model path and toggle
FINETUNED_WHISPER_PATH=./whisper-provoc-small/final
USE_FINETUNED_WHISPER=false
