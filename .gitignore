# Virtual environment
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local databases
*.db
*.sqlite3
*.db.lock

# Secrets — never commit the real .env
.env

# Logs
*.log
server.err
server.out

# ML models
whisper-provoc-small/

# IDE
.vscode/

# Milvus data volumes (Docker Compose bind mounts — never commit binary data)
volumes/
*.wal
*.tmp

# Local ngrok binary (downloaded as fallback when Chocolatey shim is broken)
ngrok.exe
